#include <Model/CubismUserModel.hpp>
#include <Effect/CubismBreath.hpp>
#include <Effect/CubismEyeBlink.hpp>
#include <Effect/CubismPose.hpp>
#include <Physics/CubismPhysics.hpp>
#include <Motion/CubismMotion.hpp>
#include <Motion/CubismMotionManager.hpp>
#include <Rendering/OpenGL/CubismRenderer_OpenGLES2.hpp>
#include <Utils/CubismString.hpp>

// stb_image dibundel SDK — untuk memuat PNG tekstur (pola LAppTextureManager).
#define STB_IMAGE_IMPLEMENTATION
#include <stb_image.h>

using namespace Live2D::Cubism::Framework;
using Csm::csmByte;
using Csm::csmSizeInt;

namespace {

// Alokator untuk Framework (pola LAppAllocator resmi: malloc/free).
class Alokator : public Csm::ICubismAllocator {
 public:
  void* Allocate(const Csm::csmSizeType ukuran) override {
    return std::malloc(ukuran);
  }
  void Deallocate(void* memori) override { std::free(memori); }
  void* AllocateAligned(const Csm::csmSizeType ukuran,
                        const Csm::csmUint32 alignment) override {
    size_t n = static_cast<size_t>(ukuran);
    const size_t a = alignment ? alignment : alignof(void*);
    n = ((n + a - 1) / a) * a;
    return std::aligned_alloc(a, n ? n : a);
  }
  void DeallocateAligned(void* memori) override { std::free(memori); }
};

Alokator gAlokator;
bool gSdkJalan = false;
std::string gFolderBinary;  // diisi App saat mulai (untuk cari shader)

// Pemuat berkas untuk Framework: dipakai memuat shader
// ("FrameworkShaders/..."). Coba direktori kerja, lalu folder binary.
csmByte* muatBerkasSdk(const std::string jalur, csmSizeInt* ukuran) {
  std::vector<unsigned char> isi;
  if (!bacaBerkas(jalur, isi) && !gFolderBinary.empty()) {
    if (!bacaBerkas(gFolderBinary + "/" + jalur, isi)) return nullptr;
  }
  if (isi.empty()) return nullptr;
  csmByte* buf = static_cast<csmByte*>(std::malloc(isi.size()));
  if (!buf) return nullptr;
  std::memcpy(buf, isi.data(), isi.size());
  *ukuran = static_cast<csmSizeInt>(isi.size());
  return buf;
}

void lepasBerkasSdk(Csm::csmByte* berkas) { std::free(berkas); }

// Nyalakan Framework sekali per proses. Harus dipanggil saat konteks GL
// avatar sedang aktif (CreateRenderer memanggil fungsi GL).
bool pastikanSdkJalan() {
  if (gSdkJalan) return true;
  Csm::CubismFramework::Option opsi;
  opsi.LogFunction = nullptr;
  opsi.LoggingLevel = Csm::CubismFramework::Option::LogLevel_Off;
  opsi.LoadFileFunction = muatBerkasSdk;
  opsi.ReleaseBytesFunction = lepasBerkasSdk;
  if (!Csm::CubismFramework::StartUp(&gAlokator, &opsi)) return false;
  Csm::CubismFramework::Initialize();
  gSdkJalan = true;
  return true;
}

}  // namespace

// === LANJUTAN-BAGIAN-4 ===

std::string ModelLive2D::muatModel(const std::string& model3Path,
                                   const std::string& folderModel) {
#ifdef AVATAR_HAVE_CUBISM
  if (!pastikanSdkJalan()) {
    galat_ =
        "SDK Cubism belum disiapkan di sistem.\\n\\n"
        "Unduh Cubism SDK for Native dari situs Live2D, lalu bangun ulang — "
        "caranya ada di README (bagian 'Cubism SDK').";
    return galat_;
  }

  Rincian* r = new Rincian;
  r->salah = false;
  r->model3Path = model3Path;
  r->folderModel = folderModel;
  r->waktu = 0.0f;
  r->model3 = nullptr;
  r->moc = nullptr;
  r->userModel = nullptr;
  r->modelSetting = nullptr;
  r->motionManager = nullptr;
  r->expressionManager = nullptr;
  r->eyeBlink = nullptr;
  r->breath = nullptr;
  r->pose = nullptr;
  r->physics = nullptr;
  r->renderer = nullptr;
  r->offscreen = nullptr;
  r->shaderProgram = 0;
  r->VAO = 0;
  r->VBO = 0;
  r->EBO = 0;
  r->scale = 1.0f;
  r->rataTengahX = 0.0f;
  r->rataTengahY = 0.0f;

  r->model3 = Csm::CubismModel::Create();
  if (!r->model3) {
    galat_ = "Gagal membuat objek model Live2D.";
    delete r;
    return galat_;
  }
  const bool muat = r->model3->Load(r->model3Path.c_str());
  if (!muat) {
    galat_ = "Gagal memuat " + r->model3Path +
             ". Pastikan berkas .model3.json dan .moc3 ada di folder.";
    delete r;
    return galat_;
  }

  r->moc = r->model3->GetMoc();
  if (!r->moc) {
    galat_ = "Gagal mendapatkan data .moc3 dari model.";
    delete r;
    return galat_;
  }
  r->moc->SetModel(r->model3.get());

  const std::string modelName =
      r->model3->GetModelSetting()->GetModelName();
  nama_ = modelName;

  // ModelSetting (drag & drop, pose, parameter).
  r->modelSetting = new Csm::CubismModelSettingJson;
  if (!r->modelSetting->Load(r->model3Path.c_str())) {
    delete r->modelSetting;
    r->modelSetting = nullptr;
  }

  r->userModel = new Csm::CubismUserModel;
  if (!r->userModel->Setup(r->moc)) {
    delete r->userModel;
    r->userModel = nullptr;
    galat_ = "Gagal menyusun model dari .moc3.";
    delete r;
    return galat_;
  }
  r->userModel->SetVisibility(false);
  r->userModel->SetPose(nullptr);

  // Framework SDK meminta nama model untuk mencari resource (tekstur, motion).
  r->userModel->SetModelName(modelName.c_str());

  // Manager motion — ambil grup motion, prioritas, komentar dari model config
  // (misal: Motion > Idle > 0 > 5 > "default").
  r->motionManager = new Csm::CubismMotionManager;
  const bool sdBisa = r->motionManager->Setup(r->moc);
  if (!sdBisa) {
    delete r->motionManager;
    r->motionManager = nullptr;
  }

  r->expressionManager = new Csm::CubismExpressionManager;
  const bool expDapat = r->expressionManager->Setup(r->moc);
  if (!expDapat) {
    delete r->expressionManager;
    r->expressionManager = nullptr;
  }

  // EyeBlink / Breath / Pose / Physics — selalu ada di model contoh.
  r->eyeBlink = new Csm::CubismEyeBlink;
  if (!r->eyeBlink->Setup(r->moc)) {
    delete r->eyeBlink;
    r->eyeBlink = nullptr;
  }

  r->breath = new Csm::CubismBreath;
  if (!r->breath->Setup(r->moc)) {
    delete r->breath;
    r->breath = nullptr;
  }

  r->pose = new Csm::CubismPose;
  if (!r->pose->Setup(r->moc)) {
    delete r->pose;
    r->pose = nullptr;
  }

  r->physics = new Csm::CubismPhysics;
  if (!r->physics->Setup(r->moc)) {
    delete r->physics;
    r->physics = nullptr;
  }

  // Spread/Widen/ApplyPhysics akan diatur tiap frame (fair-skinned fallback).
  // ID model contoh biasanya bertipe float/bool, jadi ini tumpang tindih
  // dengan parameter default SDK. Karena itu sinkronisasi desimal dibuat
  // eksplisit di perbarui() berikutnya.

  // Baca konfigurasi untuk mengatur layar default (kalau ada).
  jikaAdaKonfigurasi(r);

  // Hitungan ekran untuk pemodelan (scaling, centering) dilakukan di
  // gambar() setelah konteks GL avatar aktif.

  // Grafik kinerja: jalankan physics ringan (bukan fallback shader) dengan
  // vSync off.
  if (!r->physics->IsInitialized()) {
    if (!r->physics->Setup(r->moc)) r->salah = true;
  }
  if (r->physics->IsInitialized()) {
    r->physics->AddParameter(r->userModel->GetModelParameterId(
        Csm::CubismParameterId::DefaultParameterId::Breath));
    r->physics->AddParameter(r->userModel->GetModelParameterId(
        Csm::CubismParameterId::DefaultParameterId::EyeBlink));
    r->physics->AddParameter(r->userModel->GetModelParameterId(
        Csm::CubismParameterId::DefaultParameterId::Pose));
  }

  jikaAdaMotionGrup(r, "Idle");
  jikaAdaMotionGrup(r, "idle");
  jikaAdaMotionGrup(r, "Idle_M");
  jikaAdaMotionGrup(r, "motion");

  // Physics diaktifkan setelah motion ter-update.
  if (r->physics->IsInitialized()) {
    r->physics->UpdateParameter(r->userModel->GetModelParameterId(
        Csm::CubismParameterId::DefaultParameterId::Physics));
  }

  ada_ = true;
  return {};
#else
  galat_ =
      "SDK Cubism belum dipasang di sistem.\\n\\n"
      "Unduh Cubism SDK for Native dari situs Live2D, lalu bangun ulang — "
      "caranya ada di README (bagian 'Cubism SDK').";
  return galat_;
#endif
}
